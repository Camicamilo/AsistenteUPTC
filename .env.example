# Copia este archivo como .env para cambiar la configuración.

# true  = el chat y el panel usan datos simulados (no necesitan backend).
# false = se llama a la API REST real del backend Spring Boot.
VITE_USE_MOCK=true

# Prefijo de la API REST. En desarrollo Vite redirige /api al backend (ver vite.config.js).
VITE_API_BASE_URL=/api

# URL del backend Spring Boot para el proxy de desarrollo.
VITE_BACKEND_URL=http://localhost:8080

# Tiempo máximo de espera de una petición del chat, en milisegundos.
VITE_REQUEST_TIMEOUT_MS=8000
